#!/usr/bin/env python3
# The commit-msg tier of sd:1931: a trailer git will not read is refused.
#
# Git reads trailers from the final paragraph of a message and from nowhere
# else. One blank line above `Needed-by:` or `Delivers:` puts it in a
# paragraph of its own, and so does prose around it; the message still looks
# right, and `git log -1 --format='%(trailers:key=Delivers,valueonly)'`
# prints nothing, while a line reader still calls the item delivered
# (sd:3014). b0c440ad on sd:1910 did exactly that with `Needed-by:`, and the
# pre-commit hook, which reads staged files and not the message, passed it.
#
# The reader of record is git: the hook runs
# `git interpret-trailers --parse --no-divider` over the message file and
# refuses every line naming one of `sd_lib.CHECKED_TRAILERS` that git did
# not return (`source:bin/sd_lib.py::unread_trailers`). A message with no
# such line is not read further, so a commit that states no trailers keeps
# the behaviour it had before this hook.
#
# `SD_SKIP_HOOKS=1` does not skip it. That variable exists because the
# pre-commit tier costs seconds; this one costs at most four git calls.
# `--no-verify` still skips it, as it skips every commit-msg hook.
#
# Installed by `make hooks` beside the pre-commit tier, as the link
# <common .git>/hooks/commit-msg -> ../../hooks/commit-msg: one per clone,
# read from the main checkout, shared by every linked worktree. The hook
# reads `sd_lib` from the `bin/` beside its own real path, never from the
# repository it runs in.
"""The commit-msg hook: every checked trailer line must be one git reads."""

from __future__ import annotations

import pathlib
import subprocess
import sys

FIX = """\
git reads trailers from the final paragraph only, and a blank line ends a paragraph.
Fix: put every trailer in the final paragraph, one per line, with no blank line inside it:

    Needed-by: sd:N
    Delivers: sd:N

Check after committing: git log -1 --format='%(trailers:key=Delivers,valueonly)'
must print the value. The rejected message is kept in .git/COMMIT_EDITMSG.
"""


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("commit-msg: usage: commit-msg <message-file>", file=sys.stderr)
        return 2
    message_file = pathlib.Path(argv[1])
    root = pathlib.Path(subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip())
    # The pack this file belongs to, by real path, not the repository it runs in (sd:2546).
    pack_bin = pathlib.Path(__file__).resolve().parents[1] / "bin"
    sys.path.insert(0, str(pack_bin))
    try:
        import sd_lib
        import sd_ship_body
    except Exception as error:  # the hook must name why it could not read, not crash
        print(f"commit-msg: unchecked, cannot import from {pack_bin}: {error}",
              file=sys.stderr)
        return 1
    message = message_file.read_text(encoding="utf-8", errors="replace")
    # pack sd:10212: the lane refuses a line over the limit at enqueue, after a full review; refuse it here.
    # The hook cannot see the message git saves, so it refuses only a line git certainly keeps.
    # A merge, revert, cherry-pick, rebase or squash merge replays git's own message (sd-ship's
    # catch-up merge runs this hook too); the lane still measures what lands.
    gitdir = (sd_lib.git_output(["rev-parse", "--path-format=absolute", "--git-dir"], root) or "").strip()
    replaying = bool(gitdir) and any(
        (pathlib.Path(gitdir) / name).exists()
        for name in ("MERGE_HEAD", "REVERT_HEAD", "CHERRY_PICK_HEAD", "SQUASH_MSG",
                     "rebase-merge", "rebase-apply"))
    # A fixup, squash or amend commit carries git's `<kind>! <subject>`, and autosquash removes it.
    if not replaying and not message.startswith(("fixup! ", "squash! ", "amend! ")):
        # Comment lines: any char git's `auto` may pick, or the configured string; a verbose diff
        # sits below a scissors line in that char. ponytail: such a line is skipped even where git
        # keeps it (-m/-F); the lane refuses it (filed with the --body-only advisory).
        # Read raw: git_output strips stdout, and a comment string may start with spaces.
        configured = (subprocess.run(["git", "config", "--get", key], cwd=root, capture_output=True,
                                     text=True, check=False).stdout.rstrip("\n")
                      for key in ("core.commentString", "core.commentChar"))
        prefixes = tuple("#;@!$%^&|:") + tuple(value for value in configured if value not in ("", "auto"))
        lines = message.split("\n")
        cut = next((at for at, line in enumerate(lines)
                    if line.startswith(prefixes) and line.endswith(" " + "-" * 24 + " >8 " + "-" * 24)),
                   len(lines))
        # Git keeps comment lines under -m/-F and drops its one comment char's lines in the editor,
        # and either can change the block structure (a fence opens or closes). A line is refused
        # only when it is long in every reading: all lines kept, and each candidate char dropped.
        # Git strips only ASCII trailing whitespace.
        kept = [line.rstrip(" \t\r\v\f") for line in lines[:cut]]
        refused = None
        for drop in (None, *prefixes):
            index = [at for at, line in enumerate(kept) if drop is None or not line.startswith(drop)]
            found = {index[number - 1] for number, _ in
                     sd_ship_body.long_lines("\n".join(kept[at] for at in index))}
            refused = found if refused is None else refused & found
        long = [(at + 1, len(kept[at])) for at in sorted(refused or ())
                if not kept[at].startswith(prefixes)]
        if long:
            for number, length in long:
                print(f"commit-msg: refused, a line is {length} characters (limit {sd_ship_body.LINE_LIMIT}): "
                      f"{kept[number - 1][:40]}...", file=sys.stderr)
            print("Rewrap it; a fenced code line or a bare URL line is exempt. "
                  "The rejected message is kept in .git/COMMIT_EDITMSG.", file=sys.stderr)
            return 1
    if not sd_lib.unread_trailers(message, ""):  # states none of the checked trailers
        return 0
    parsed = sd_lib.git_output(
        ["interpret-trailers", "--parse", "--no-divider", str(message_file.resolve())], root
    )
    if parsed is None:
        print("commit-msg: unchecked, `git interpret-trailers --parse` did not answer",
              file=sys.stderr)
        return 1
    stray = sd_lib.unread_trailers(message, parsed)
    if not stray:
        return 0
    noun = "line" if len(stray) == 1 else "lines"
    print(f"commit-msg: refused, {len(stray)} trailer {noun} git will not read as a trailer:",
          file=sys.stderr)
    for line in stray:
        print(f"    {line}", file=sys.stderr)
    print(FIX, end="", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
