#!/usr/bin/env python3
# The commit-msg tier of sd:1931: a trailer git will not read is refused.
#
# Git reads trailers from the final paragraph of a message and from nowhere
# else. One blank line above `Needed-by:` or `Delivers:` puts it in a
# paragraph of its own, and so does prose around it; the message still looks
# right, and `git log -1 --format='%(trailers:key=Delivers,valueonly)'`
# prints nothing, while a line reader still calls the item delivered
# (sd:3014). b0c440ad on sd:1910 did exactly that with `Needed-by:`, and the
# pre-commit hook, which reads staged files and not the message, passed it.
#
# The reader of record is git: the hook runs
# `git interpret-trailers --parse --no-divider` over the message file and
# refuses every line naming one of `sd_lib.CHECKED_TRAILERS` that git did
# not return (`source:bin/sd_lib.py::unread_trailers`). A message with no
# such line is not read further, so a commit that states no trailers keeps
# the behaviour it had before this hook.
#
# `SD_SKIP_HOOKS=1` does not skip it. That variable exists because the
# pre-commit tier costs seconds; this one costs one git call.
# `--no-verify` still skips it, as it skips every commit-msg hook.
#
# Installed by `make hooks` beside the pre-commit tier, as the link
# <common .git>/hooks/commit-msg -> ../../hooks/commit-msg: one per clone,
# read from the main checkout, shared by every linked worktree. The hook
# reads `sd_lib` from the `bin/` beside its own real path, never from the
# repository it runs in.
"""The commit-msg hook: every checked trailer line must be one git reads."""

from __future__ import annotations

import pathlib
import subprocess
import sys

FIX = """\
git reads trailers from the final paragraph only, and a blank line ends a paragraph.
Fix: put every trailer in the final paragraph, one per line, with no blank line inside it:

    Needed-by: sd:N
    Delivers: sd:N

Check after committing: git log -1 --format='%(trailers:key=Delivers,valueonly)'
must print the value. The rejected message is kept in .git/COMMIT_EDITMSG.
"""


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("commit-msg: usage: commit-msg <message-file>", file=sys.stderr)
        return 2
    message_file = pathlib.Path(argv[1])
    root = pathlib.Path(subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip())
    # The pack this file belongs to, by real path, not the repository it runs in (sd:2546).
    pack_bin = pathlib.Path(__file__).resolve().parents[1] / "bin"
    sys.path.insert(0, str(pack_bin))
    try:
        import sd_lib
        import sd_ship_body
    except Exception as error:  # the hook must name why it could not read, not crash
        print(f"commit-msg: unchecked, cannot import from {pack_bin}: {error}",
              file=sys.stderr)
        return 1
    message = message_file.read_text(encoding="utf-8", errors="replace")
    # pack sd:10212: the lane refuses a line over the limit at enqueue, after a full review; warn here.
    # A merge, revert, cherry-pick or rebase replays git's own message (sd-ship's catch-up merge runs
    # this hook too), so it is not measured; the lane still measures what lands.
    replaying = any(
        (path := sd_lib.git_output(["rev-parse", "--git-path", name], root)) and (root / path).exists()
        for name in ("MERGE_HEAD", "REVERT_HEAD", "CHERRY_PICK_HEAD", "rebase-merge", "rebase-apply"))
    if not replaying:
        # Git drops comment lines, a verbose commit's diff below the scissors and trailing spaces
        # after this hook runs. The refusal quotes the line, since that cleanup can renumber lines.
        # ponytail: comment lines are skipped though git keeps them under -m/-F, and commentChar=auto
        # reads as `#`; the lane still refuses such a line (filed with the --body-only advisory).
        char = (sd_lib.git_output(["config", "core.commentChar"], root) or "").strip()
        char = char if char and char != "auto" else "#"
        above = message.split(f"\n{char} " + "-" * 24 + " >8 " + "-" * 24 + "\n", 1)[0]
        kept = [line.rstrip() for line in above.split("\n") if not line.startswith(char)]
        long = sd_ship_body.long_lines("\n".join(kept))
        # A warning, not a refusal: the hook cannot see the message git saves (comment string, fixup,
        # cleanup mode), and four review rounds each found a valid commit it refused. The lane refuses.
        for number, length in long:
            print(f"commit-msg: warning, a line is {length} characters (limit {sd_ship_body.LINE_LIMIT}): "
                  f"{kept[number - 1][:40]}...", file=sys.stderr)
        if long:
            print("sd-ship refuses it at enqueue; reword now with `git commit --amend` (before any review). "
                  "A fenced code line or a bare URL line is exempt.", file=sys.stderr)
    if not sd_lib.unread_trailers(message, ""):  # states none of the checked trailers
        return 0
    parsed = sd_lib.git_output(
        ["interpret-trailers", "--parse", "--no-divider", str(message_file.resolve())], root
    )
    if parsed is None:
        print("commit-msg: unchecked, `git interpret-trailers --parse` did not answer",
              file=sys.stderr)
        return 1
    stray = sd_lib.unread_trailers(message, parsed)
    if not stray:
        return 0
    noun = "line" if len(stray) == 1 else "lines"
    print(f"commit-msg: refused, {len(stray)} trailer {noun} git will not read as a trailer:",
          file=sys.stderr)
    for line in stray:
        print(f"    {line}", file=sys.stderr)
    print(FIX, end="", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
